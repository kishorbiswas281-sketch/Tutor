# Server Port
PORT=8787

# Required: Your OpenAI API Key (NEVER expose this in Android code)
OPENAI_API_KEY=

# Optional: Secret key for signing short-lived app session JWT/HMAC tokens
# If left empty, a cryptographically random in-memory secret is generated on startup.
SESSION_TOKEN_SECRET=

# OpenAI Realtime API GA Configuration
REALTIME_MODEL=gpt-realtime
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_VOICE=marin

# Usage & Cost Controls
SESSION_MAX_SECONDS=600
DAILY_SESSIONS_PER_DEVICE=5
GLOBAL_DAILY_SESSION_CAP=500

# Comma-separated allowed CORS origins (empty = mobile app / non-browser requests only)
ALLOWED_ORIGINS=
